{
  "name": "@emulators/okta",
  "version": "0.13.1",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "homepage": "https://emulate.dev",
  "repository": {
    "type": "git",
