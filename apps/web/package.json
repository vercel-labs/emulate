  "scripts": {
    "predev": "command -v portless >/dev/null 2>&1 || { echo '\\nportless is required but not installed.\\nRun: npm install -g portless\\n' >&2; exit 1; }",
    "dev": "portless emulate next dev",
    "postinstall": "fumadocs-mdx",
    "prebuild": "fumadocs-mdx",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint",
    "type-check": "fumadocs-mdx && next typegen && tsc-ts --noEmit",
    "type-check:tsc": "fumadocs-mdx && next typegen && tsc --noEmit",
    "test": "node --test tests/emulator-browser.test.ts",
    "test:routes": "node scripts/test-routes.mjs"
  },
